{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, max-age=0"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "no-store"
        },
        {
          "key": "Vercel-CDN-Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "outputDirectory": ".",
  "rewrites": [
    {
      "source": "/api/student-portal/courses",
      "destination": "/api/revenue?route=student-courses"
    },
    {
      "source": "/api/student-portal/certificate-verify",
      "destination": "/api/revenue?route=student-certificate-verify"
    },
    {
      "source": "/api/admin/operations",
      "destination": "/api/revenue?route=admin-operations"
    },
    {
      "source": "/api/admin/products",
      "destination": "/api/revenue?route=admin-products"
    },
    {
      "source": "/api/admin/site-content",
      "destination": "/api/revenue?route=admin-site-content"
    },
    {
      "source": "/api/admin/system-settings",
      "destination": "/api/revenue?route=admin-system-settings"
    },
    {
      "source": "/portal",
      "destination": "https://yscmt-react.vercel.app/"
    },
    {
      "source": "/portal/:path*",
      "destination": "https://yscmt-react.vercel.app/:path*"
    },
    {
      "source": "/api/business-directory",
      "destination": "/api/revenue?route=directory"
    },
    {
      "source": "/api/admin/business-directory",
      "destination": "/api/revenue?route=admin-directory"
    },
    {
      "source": "/api/revenue/health",
      "destination": "/api/revenue?route=health"
    },
    {
      "source": "/api/jobs",
      "destination": "/api/revenue?route=jobs"
    },
    {
      "source": "/api/admin/jobs",
      "destination": "/api/revenue?route=admin-jobs"
    },
    {
      "source": "/api/admin/revenue-health",
      "destination": "/api/revenue?route=admin-health"
    },
    {
      "source": "/api/featured-payment",
      "destination": "/api/revenue?route=featured-init"
    },
    {
      "source": "/api/featured-payment/verify",
      "destination": "/api/revenue?route=featured-verify"
    },
    {
      "source": "/api/featured-payment/webhook",
      "destination": "/api/revenue?route=featured-webhook"
    },
    {
      "source": "/api/digital-services",
      "destination": "/api/revenue?route=digital-services"
    },
    {
      "source": "/api/marketplace",
      "destination": "/api/revenue?route=marketplace"
    },
    {
      "source": "/api/advertising",
      "destination": "/api/revenue?route=advertising"
    },
    {
      "source": "/api/affiliates",
      "destination": "/api/revenue?route=affiliates"
    },
    {
      "source": "/api/affiliate-click",
      "destination": "/api/revenue?route=affiliate-click"
    },
    {
      "source": "/api/communications",
      "destination": "/api/revenue?route=communications"
    },
    {
      "source": "/api/admin/enterprise-modules",
      "destination": "/api/revenue?route=admin-enterprise-modules"
    },
    {
      "source": "/api/admin/billing",
      "destination": "/api/revenue?route=admin-billing"
    },
    {
      "source": "/api/invoice-payment/webhook",
      "destination": "/api/revenue?route=invoice-webhook"
    },
    {
      "source": "/api/invoice-payment",
      "destination": "/api/revenue?route=invoice"
    },
    {
      "source": "/api/events-sponsorship",
      "destination": "/api/revenue?route=events"
    }
  ]
}
