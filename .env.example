# Copy to .env.local for local development.
# Never commit .env.local or paste its values into chat.

# Neon revenue database only (keep existing Supabase variables separate).
REVENUE_DATABASE_URL=replace-with-neon-development-connection-string

# Neon Object Storage branch credentials (populated by: neon env pull --file .env.local).
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
REVENUE_ASSETS_BUCKET=yscmt-revenue-assets

# Protects the private GET /api/revenue/health diagnostic endpoint.
REVENUE_HEALTH_TOKEN=generate-a-long-random-secret
