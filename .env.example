# Copy to .env.local for local development.
# Never commit .env.local or paste its values into chat.

# Neon revenue database only (keep existing Supabase variables separate).
REVENUE_DATABASE_URL=replace-with-neon-development-connection-string

# Neon Object Storage credentials for the same branch as the database.
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
REVENUE_ASSETS_BUCKET=yscmt-revenue-assets

# Paystack credentials are server-side only. Live checkout and verification are production-only.
REVENUE_PAYSTACK_SECRET_KEY=
REVENUE_PAYSTACK_WEBHOOK_SECRET=

# Keep live Featured Business checkout disabled until Paystack credentials, webhook, database and storage are verified.
REVENUE_PAYMENTS_ENABLED=false

# Security controls.
REVENUE_RATE_LIMIT_SECRET=generate-a-long-random-secret
REVENUE_HEALTH_TOKEN=generate-a-long-random-secret
